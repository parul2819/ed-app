ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2048

# Which LLM provider to use: "anthropic" or "qwen".
# If LLM_PROVIDER=anthropic but ANTHROPIC_API_KEY is not set, the app
# automatically falls back to the qwen provider instead of failing.
LLM_PROVIDER=anthropic

# Qwen provider: calls a local Ollama server's /api/chat endpoint.
# 600s gives CPU-only qwen3:4b review calls (think=true) enough headroom --
# they routinely take 4-5 minutes and a 300s timeout intermittently fails them.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=600

# How many times generate_questions()/get_solution() call the LLM before
# giving up on invalid JSON (1 initial attempt + retries).
LLM_MAX_ATTEMPTS=2

# Stage-2 quality review of generated questions (see llm_client.review_question).
# Set to false to skip the LLM review step and only run programmatic validation.
REVIEW_ENABLED=true
ANTHROPIC_REVIEW_MODEL=claude-sonnet-4-6
OLLAMA_REVIEW_MODEL=qwen3:4b

# Postgres (used by docker-compose.yml and DATABASE_URL below)
POSTGRES_USER=masti
POSTGRES_PASSWORD=masti
POSTGRES_DB=learn_with_masti
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://masti:masti@localhost:5432/learn_with_masti

# Bounds on how long a single DB connection attempt / query is allowed to hang
# before failing with a clear error, instead of hanging indefinitely if
# Postgres is unreachable or a query is stuck behind a lock.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
PARENT_JWT_EXPIRE_MINUTES=10080
CHILD_JWT_EXPIRE_MINUTES=180

# Minimum accuracy percentage required to earn each star count
STAR_THRESHOLD_3=90
STAR_THRESHOLD_2=70
STAR_THRESHOLD_1=50

# Frontend origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
